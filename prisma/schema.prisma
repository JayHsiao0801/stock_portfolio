generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Portfolio {
  id          String    @id @default(cuid())
  name        String
  description String?
  currency    String    @default("TWD")
  isDefault   Boolean   @default(false)
  plannedCash      Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  holdings    Holding[]
  loans       Loan[]
}

model Loan {
  id               String    @id @default(cuid())
  portfolioId      String
  portfolio        Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  label            String    @default("")
  remainingLoan    Float     @default(0)
  loanInterestRate Float     @default(0)
  loanMonths       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([portfolioId])
}

model Holding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker      String
  name        String
  shares      Float
  avgCost     Float
  currency    String    @default("TWD")
  sector        String?
  notes         String?
  dividendYield Float     @default(0)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  transactions Transaction[]

  @@index([portfolioId])
}

model Transaction {
  id        String   @id @default(cuid())
  holdingId String
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  type      String
  shares    Float
  price     Float
  fee       Float    @default(0)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([holdingId])
}

model AppSettings {
  id                String   @id @default("singleton")
  activePortfolioId String?
  aiProvider        String   @default("claude")
  exchangeRate      Float    @default(32.0)
  monthlyExpense    Float    @default(0)
  dividendTaxRate   Float    @default(10.0)
  brokerageFeeRate  Float    @default(0.1425)
  stockMarket       String   @default("tw")
  updatedAt         DateTime @updatedAt
}

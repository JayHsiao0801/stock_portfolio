# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（.env.example 除外，需要上傳 GitHub 讓其他人知道需要哪些 key）
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite 資料庫檔案（不上傳個人資料）
*.db
*.db-journal
*.db-wal
*.db-shm

# npm 本地 cache
.npm-cache/

# Claude Code 本機設定
.claude/

# 伺服器重啟信號（暫存）
.restart_signal

# 資料庫
DATABASE_URL="file:./prisma/dev.db"

# Anthropic Claude（選填）
# 取得：https://console.anthropic.com/
# 不填則 Claude 選項在 UI 自動停用，不影響其他功能
ANTHROPIC_API_KEY=

# Google Gemini（選填）
# 取得：https://aistudio.google.com/app/apikey
# 不填則 Gemini 選項在 UI 自動停用，不影響其他功能
GOOGLE_GENERATIVE_AI_API_KEY=

# 股價使用 yahoo-finance2，不需要 API key
# App 名稱（可自訂）
NEXT_PUBLIC_APP_NAME="Stock Portfolio Manager"
